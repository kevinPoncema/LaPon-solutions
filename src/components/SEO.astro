---
// Archivo: src/components/SEO.astro
import serviciosData from "../json/servicios.json";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
}

const siteUrl = "https://lapontech.com";
const companyName = "LaPon Tech Solutions";

const {
  title = "LaPonTech | Páginas Web, Sistemas a Medida y Marca Blanca",
  description = "Páginas web rápidas, sistemas a medida sin rentas forzosas y brazo técnico en marca blanca para agencias en San Pedro Sula y Honduras. ¡Cotiza por WhatsApp!",
  canonical = Astro.url.pathname,
  ogImage = "/logo-completo.png",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(canonical, siteUrl).toString();
const fullOgImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, siteUrl).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  "name": companyName,
  "alternateName": ["LaPonTech", "LaPon Tech", "LaPon Tech Solution"],
  "slogan": "Páginas web rápidas y sistemas a medida para tu negocio en Honduras sin rentas forzosas",
  "url": `${siteUrl}/`,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/logo-completo.png`,
    "width": 1024,
    "height": 517
  },
  "image": fullOgImageUrl,
  "description": "Creamos páginas web ultrarrápidas con catálogo de pedidos para WhatsApp y sistemas a medida de inventario, facturación y punto de venta (POS) para comercios y PYMEs en San Pedro Sula y toda Honduras, sin mensualidades forzosas.",
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "San Pedro Sula",
    "addressLocality": "San Pedro Sula",
    "addressRegion": "Cortés",
    "postalCode": "21101",
    "addressCountry": "HN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 15.5042,
    "longitude": -88.0250
  },
  "areaServed": [
    { "@type": "City", "name": "San Pedro Sula" },
    { "@type": "City", "name": "Choloma" },
    { "@type": "City", "name": "Villanueva" },
    { "@type": "City", "name": "El Progreso" },
    { "@type": "City", "name": "Puerto Cortés" },
    { "@type": "City", "name": "La Lima" },
    { "@type": "City", "name": "Tegucigalpa" },
    { "@type": "AdministrativeArea", "name": "Cortés" },
    { "@type": "Country", "name": "Honduras" }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": "Comercios, PYMEs y Agencias de Marketing y Diseño en Honduras",
    "audienceType": "Pequeñas y medianas empresas (ferreterías, farmacias, repuestos, distribuidoras, talleres, restaurantes, clínicas) y Agencias de Marketing, Publicidad y Diseño (servicio en modalidad Marca Blanca)"
  },
  "knowsAbout": [
    "Diseño de páginas web y landings de conversión en San Pedro Sula",
    "Optimización GEO (Generative Engine Optimization) para motores de IA",
    "Desarrollo web y soporte técnico en Marca Blanca para agencias de marketing",
    "Sistemas de inventario, facturación y punto de venta (POS) a medida",
    "Automatización de prospectos y campañas con WhatsApp y CRM (webhooks)",
    "Configuración de servidores, DNS y correos corporativos (SPF, DKIM, DMARC)",
    "Asesoría tecnológica y mantenimiento opcional para empresas"
  ],
  "founder": [
    {
      "@type": "Person",
      "name": "David Flores Lagos",
      "jobTitle": "Co-Fundador · Técnico en Informática Orientada a la Programación (Atención al Cliente, Diseño Web y Soporte Técnico)"
    },
    {
      "@type": "Person",
      "name": "Kevin D. Ponce",
      "jobTitle": "Co-Fundador · Técnico en Informática Orientada a la Programación (Diseño de Sistemas, Bases de Datos e Infraestructura)"
    }
  ],
  "serviceType": serviciosData.servicios.map((s) => s.titulo),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Soluciones Digitales para Comercios y PYMEs en Honduras",
    "itemListElement": serviciosData.servicios.map((s) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.titulo,
        "description": s.descripcion,
        "provider": { "@id": `${siteUrl}/#organization` },
        "areaServed": { "@type": "Country", "name": "Honduras" }
      }
    }))
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": `${siteUrl}/`,
  "name": "LaPon Tech Solutions | Páginas Web y Sistemas sin Mensualidades en Honduras",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "es-HN"
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": {
    "@id": `${siteUrl}/#website`
  },
  "about": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "es-HN",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "#servicios h2", "#comparativa h2", "#agencias h2", "#faq details"]
  }
};
---

<!-- Metadatos Básicos -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Metaetiquetas Geográficas Obligatorias (San Pedro Sula, Honduras) -->
<meta name="geo.region" content="HN-CR" />
<meta name="geo.placename" content="San Pedro Sula" />
<meta name="geo.position" content="15.5042;-88.0250" />
<meta name="ICBM" content="15.5042, -88.0250" />

<!-- Favicons y Accesos Directos -->
<link rel="icon" type="image/svg+xml" href="/icons/logo.svg" />
<link rel="icon" type="image/png" href="/icons/logo.png" />
<link rel="apple-touch-icon" href="/icons/logo.png" />

<!-- Control de Indexación para Motores de Búsqueda -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- OpenGraph / Redes Sociales & WhatsApp -->
<meta property="og:site_name" content={companyName} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:image:url" content={fullOgImageUrl} />
<meta property="og:image:secure_url" content={fullOgImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1024" />
<meta property="og:image:height" content="517" />
<meta property="og:image:alt" content="LaPon Tech Solutions - Logotipo Oficial de la Empresa" />
<meta property="og:locale" content="es_HN" />
<meta name="image" content={fullOgImageUrl} />
<link rel="image_src" href={fullOgImageUrl} />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />
<meta name="twitter:image:alt" content="LaPon Tech Solutions - Logotipo Oficial de la Empresa" />

<!-- Google Fonts Preconnect & Font Styling -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- Schema.org JSON-LD (Validado bajo reglas Agentic-SEO-Skill) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
