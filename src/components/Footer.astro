---
// Archivo: src/components/Footer.astro
import serviciosData from "../json/servicios.json";

const currentYear = new Date().getFullYear();
const phoneClean = serviciosData.empresa.telefono_clean;
const waP1 = phoneClean.slice(0, 3);
const waP2 = phoneClean.slice(3, 7);
const waP3 = phoneClean.slice(7);
const WA_FOOTER_MSG = "Hola LaPonTech, quisiera solicitar información sobre sus servicios.";
---

<footer
  id="site-footer"
  data-wa-p1={waP1}
  data-wa-p2={waP2}
  data-wa-p3={waP3}
  class="bg-slate-950 text-slate-300 border-t border-slate-800/80 pt-16 pb-12"
  role="contentinfo"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-slate-800/80">
      
      <!-- Col 1: Brand & Firm Profile (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-3 group inline-flex focus:outline-none">
          <div class="w-11 h-11 rounded-xl bg-slate-900 border border-slate-700/80 flex items-center justify-center p-1.5 shadow-elevation-sm">
            <img
              src="/icons/logo.png"
              alt="Logo LaPon Tech Solutions"
              class="w-full h-full object-contain"
              width="44"
              height="44"
              loading="lazy"
            />
          </div>
          <div>
            <span class="text-lg font-bold text-white tracking-tight block">
              LaPon
            </span>
            <span class="text-xs text-slate-400 tracking-wider uppercase block">
              Tech Solutions · Honduras
            </span>
          </div>
        </a>

        <p class="text-slate-400 text-sm leading-relaxed max-w-md">
          Hacemos que la tecnología sea sencilla, accesible y transparente para tu negocio. Desarrollamos páginas web que atraen clientes, sistemas para ordenar inventarios y facturación, automatizaciones de WhatsApp y asesoría honesta en software y computadoras.
        </p>

        <div class="flex items-center gap-2 pt-2 text-xs text-slate-400">
          <span class="t-status-dot w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Base en San Pedro Sula · Atención 100% en línea por WhatsApp y llamada a cualquier zona</span>
        </div>

        <!-- Redes Sociales Oficiales -->
        <div class="pt-3">
          <p class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Síguenos en Redes Sociales</p>
          <div class="flex items-center gap-2.5">
            <a
              href={serviciosData.empresa.redes_sociales.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="t-press w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 flex items-center justify-center text-slate-400 hover:text-emerald-400"
              aria-label="Instagram de LaPonTech (Abre en nueva pestaña)"
              title="Instagram"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a
              href={serviciosData.empresa.redes_sociales.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="t-press w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 flex items-center justify-center text-slate-400 hover:text-emerald-400"
              aria-label="Facebook de LaPonTech (Abre en nueva pestaña)"
              title="Facebook"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a
              href={serviciosData.empresa.redes_sociales.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              class="t-press w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 flex items-center justify-center text-slate-400 hover:text-emerald-400"
              aria-label="TikTok de LaPonTech (Abre en nueva pestaña)"
              title="TikTok"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.77 1.81-.02 3.32-1.52 3.33-3.33.02-4.74.01-9.48.01-14.22-.01-.15.01-.3-.02-.45z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Soluciones para Negocios (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Servicios para Negocios
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Páginas Web & Catálogos Digitales
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Software & Sistemas a Medida
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Automatizaciones & WhatsApp
            </a>
          </li>
          <li>
            <a href="/#asesoria-tecnica" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Servidores, Correos & Equipos
            </a>
          </li>
          <li>
            <a href="/#agencias" class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors block py-1">
              Marca Blanca para Agencias
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Navegación (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Navegación
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-slate-400 hover:text-white transition-colors block py-1">
              Inicio
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-white transition-colors block py-1">
              Servicios
            </a>
          </li>
          <li>
            <a href="/#comparativa" class="text-slate-400 hover:text-white transition-colors block py-1">
              ¿Por qué elegirnos?
            </a>
          </li>
          <li>
            <a href="/#nosotros" class="text-slate-400 hover:text-white transition-colors block py-1">
              Sobre Nosotros
            </a>
          </li>
          <li>
            <a href="/#metodologia" class="text-slate-400 hover:text-white transition-colors block py-1">
              Metodología
            </a>
          </li>
          <li>
            <a href="/#faq" class="text-slate-400 hover:text-white transition-colors block py-1">
              Preguntas Frecuentes
            </a>
          </li>
          <li>
            <a href="/#contacto" class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors block py-1">
              Cotizar por WhatsApp →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Ubicación & Contacto Directo (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Sede y Contacto
        </h3>
        <address class="not-italic text-sm text-slate-400 space-y-2">
          <p class="text-white font-medium">San Pedro Sula, Cortés</p>
          <p>Honduras, Centroamérica</p>
          <div class="pt-2 space-y-2">
            <a
              href="#contacto"
              data-email-user="contacto"
              data-email-domain="lapontech.com"
              aria-label="Enviar correo corporativo a LaPonTech"
              class="js-protected-email inline-flex items-center gap-1.5 text-xs text-slate-300 hover:text-emerald-400 font-semibold transition-colors block"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span data-email-text>contacto [arroba] lapontech [punto] com</span>
            </a>
            <a
              href="/#contacto"
              data-wa-text={WA_FOOTER_MSG}
              aria-label="Escribir por WhatsApp a LaPonTech (Abre en nueva pestaña)"
              class="js-protected-wa inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 font-semibold transition-colors block"
            >
              <svg class="w-3.5 h-3.5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
              </svg>
              <span>Escribir por WhatsApp</span>
            </a>
          </div>
        </address>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
      <p>
        © {currentYear} LaPon Tech Solutions. Todos los derechos reservados. San Pedro Sula, Honduras.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a>
        <a href="/#servicios" class="hover:text-emerald-400 transition-colors">Servicios</a>
        <a href="/#nosotros" class="hover:text-emerald-400 transition-colors">Sobre Nosotros</a>
        <a href="/#faq" class="hover:text-emerald-400 transition-colors">Preguntas</a>
        <a href="/#contacto" class="hover:text-emerald-400 transition-colors">Contacto</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // Hidratación unificada de correo (.js-protected-email) y WhatsApp (.js-protected-wa) contra bots recolectores (anti-regex scraping)
  (function () {
    function hydrateProtectedContacts() {
      // 1. Hidratar enlaces de correo electrónico
      var emailLinks = document.querySelectorAll('.js-protected-email[data-email-user][data-email-domain]');
      for (var i = 0; i < emailLinks.length; i++) {
        var el = emailLinks[i];
        var u = el.getAttribute('data-email-user');
        var d = el.getAttribute('data-email-domain');
        if (u && d) {
          var full = u + String.fromCharCode(64) + d;
          el.setAttribute('href', 'mailto:' + full);
          var label = el.querySelector('[data-email-text]');
          if (label) {
            label.textContent = full;
          } else {
            el.textContent = full;
          }
        }
      }

      // 2. Hidratar enlaces de WhatsApp
      var sourceEl = document.getElementById('site-footer') || document.getElementById('contact-form');
      var p1 = (sourceEl && sourceEl.getAttribute('data-wa-p1')) || '504';
      var p2 = (sourceEl && sourceEl.getAttribute('data-wa-p2')) || '8900';
      var p3 = (sourceEl && sourceEl.getAttribute('data-wa-p3')) || '5569';
      var waPhone = p1 + p2 + p3;
      var waHost = 'https://' + 'wa' + '.me/';

      var waLinks = document.querySelectorAll('.js-protected-wa[data-wa-text]');
      for (var j = 0; j < waLinks.length; j++) {
        var waEl = waLinks[j];
        var msg = waEl.getAttribute('data-wa-text') || 'Hola LaPonTech, quisiera solicitar información sobre sus servicios.';
        waEl.setAttribute('href', waHost + waPhone + '?text=' + encodeURIComponent(msg));
        waEl.setAttribute('target', '_blank');
        waEl.setAttribute('rel', 'noopener noreferrer');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrateProtectedContacts);
    } else {
      hydrateProtectedContacts();
    }
  })();
</script>
