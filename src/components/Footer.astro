---
// Archivo: src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 border-t border-slate-800/80 pt-16 pb-12" role="contentinfo">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-slate-800/80">
      
      <!-- Col 1: Brand & Firm Profile (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-3 group inline-flex focus:outline-none">
          <div class="w-11 h-11 rounded-xl bg-slate-900 border border-slate-700/80 flex items-center justify-center p-1.5 shadow-glow-emerald">
            <img
              src="/icons/logo.png"
              alt="Logo LaPon Tech Solutions"
              class="w-full h-full object-contain"
              width="44"
              height="44"
              loading="lazy"
            />
          </div>
          <div>
            <span class="text-lg font-bold text-white tracking-tight block">
              LaPon
            </span>
            <span class="text-xs text-slate-400 tracking-wider uppercase block">
              Tech Solutions · Honduras
            </span>
          </div>
        </a>

        <p class="text-slate-400 text-sm leading-relaxed max-w-md">
          Hacemos que la tecnología sea sencilla, accesible y transparente para tu negocio. Desarrollamos páginas web que atraen clientes, sistemas para ordenar inventarios y facturación, automatizaciones de WhatsApp y asesoría honesta en software y computadoras.
        </p>

        <div class="flex items-center gap-2 pt-2 text-xs text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Base en San Pedro Sula · Atención 100% en línea por WhatsApp y llamada a cualquier zona</span>
        </div>
      </div>

      <!-- Col 2: Soluciones para Negocios (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Servicios para Negocios
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Páginas Web & Catálogos Digitales
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Software & Sistemas a Medida
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Automatizaciones & WhatsApp
            </a>
          </li>
          <li>
            <a href="/#asesoria-tecnica" class="text-slate-400 hover:text-emerald-400 transition-colors block py-1">
              Servidores, Correos & Equipos
            </a>
          </li>
          <li>
            <a href="/#agencias" class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors block py-1">
              Marca Blanca para Agencias
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Navegación (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Navegación
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-slate-400 hover:text-white transition-colors block py-1">
              Inicio
            </a>
          </li>
          <li>
            <a href="/#servicios" class="text-slate-400 hover:text-white transition-colors block py-1">
              Servicios
            </a>
          </li>
          <li>
            <a href="/#comparativa" class="text-slate-400 hover:text-white transition-colors block py-1">
              ¿Por qué elegirnos?
            </a>
          </li>
          <li>
            <a href="/#nosotros" class="text-slate-400 hover:text-white transition-colors block py-1">
              Sobre Nosotros
            </a>
          </li>
          <li>
            <a href="/#metodologia" class="text-slate-400 hover:text-white transition-colors block py-1">
              Metodología
            </a>
          </li>
          <li>
            <a href="/#faq" class="text-slate-400 hover:text-white transition-colors block py-1">
              Preguntas Frecuentes
            </a>
          </li>
          <li>
            <a href="/#contacto" class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors block py-1">
              Cotizar por WhatsApp →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Ubicación & Contacto Directo (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider">
          Sede y Contacto
        </h3>
        <address class="not-italic text-sm text-slate-400 space-y-2">
          <p class="text-white font-medium">San Pedro Sula, Cortés</p>
          <p>Honduras, Centroamérica</p>
          <div class="pt-2 space-y-2">
            <a
              href="#contacto"
              data-email-user="contacto"
              data-email-domain="lapontech.com"
              aria-label="Enviar correo corporativo a LaPonTech"
              class="js-protected-email inline-flex items-center gap-1.5 text-xs text-slate-300 hover:text-emerald-400 font-semibold transition-colors block"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span data-email-text>contacto [arroba] lapontech [punto] com</span>
            </a>
            <a
              href="/#contacto"
              class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 font-semibold transition-colors block"
            >
              <svg class="w-3.5 h-3.5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
              </svg>
              <span>Escribir por WhatsApp</span>
            </a>
          </div>
        </address>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
      <p>
        © {currentYear} LaPon Tech Solutions. Todos los derechos reservados. San Pedro Sula, Honduras.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a>
        <a href="/#servicios" class="hover:text-emerald-400 transition-colors">Servicios</a>
        <a href="/#nosotros" class="hover:text-emerald-400 transition-colors">Sobre Nosotros</a>
        <a href="/#faq" class="hover:text-emerald-400 transition-colors">Preguntas</a>
        <a href="/#contacto" class="hover:text-emerald-400 transition-colors">Contacto</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // Hidratación de correo protegida contra bots recolectores (anti-regex scraping)
  (function () {
    function hydrateProtectedEmails() {
      var links = document.querySelectorAll('.js-protected-email[data-email-user][data-email-domain]');
      for (var i = 0; i < links.length; i++) {
        var el = links[i];
        var u = el.getAttribute('data-email-user');
        var d = el.getAttribute('data-email-domain');
        if (u && d) {
          var full = u + String.fromCharCode(64) + d;
          el.setAttribute('href', 'mailto:' + full);
          var label = el.querySelector('[data-email-text]');
          if (label) {
            label.textContent = full;
          } else {
            el.textContent = full;
          }
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrateProtectedEmails);
    } else {
      hydrateProtectedEmails();
    }
  })();
</script>
