---
// Archivo: src/components/Header.astro
---

<header class="fixed top-0 left-0 w-full z-50 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80 transition-colors" role="banner">
  <div class="container mx-auto flex items-center justify-between h-20 px-4 sm:px-6 lg:px-8">
    
    <!-- Logo Real de LaPon Tech Solutions -->
    <a
      href="/"
      class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg p-1"
      aria-label="LaPon Tech Solutions - Inicio"
    >
      <div class="w-11 h-11 rounded-xl bg-slate-900/90 border border-slate-700/70 flex items-center justify-center p-1.5 shadow-glow-emerald transition-all duration-300 group-hover:border-emerald-400 group-hover:scale-105">
        <img
          src="/icons/logo.png"
          alt="Logo LaPon Tech Solutions"
          class="w-full h-full object-contain"
          width="44"
          height="44"
          loading="eager"
        />
      </div>

      <div class="flex flex-col">
        <div class="flex items-baseline gap-1.5">
          <span class="text-base sm:text-lg font-extrabold tracking-tight text-white group-hover:text-emerald-400 transition-colors">
            LaPon
          </span>
          <span class="text-xs font-semibold text-emerald-400">
            Tech Solutions
          </span>
        </div>
        <span class="text-[10px] font-medium tracking-wider text-slate-400 uppercase">
          Software & Páginas Web · SPS
        </span>
      </div>
    </a>

    <!-- Desktop Navigation con anclas a la landing principal -->
    <nav class="hidden lg:flex items-center space-x-1" aria-label="Navegación principal">
      <a
        href="/"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Inicio
      </a>

      <a
        href="/#servicios"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Servicios
      </a>

      <a
        href="/#comparativa"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Comparativa
      </a>

      <a
        href="/#nosotros"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Sobre Nosotros
      </a>

      <a
        href="/#metodologia"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Metodología
      </a>

      <a
        href="/#faq"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Preguntas Frecuentes
      </a>

      <a
        href="/#contacto"
        class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-all"
      >
        Contacto
      </a>
    </nav>

    <!-- Header Actions / Direct Conversion CTA -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/#contacto"
        class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-4 py-2.5 rounded-xl text-sm transition-all duration-200 shadow-glow-emerald hover:-translate-y-0.5"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
        </svg>
        <span>Cotizar por WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="lg:hidden text-slate-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 w-11 h-11 flex items-center justify-center rounded-xl bg-slate-900 border border-slate-800 transition-colors"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden bg-slate-950/95 border-b border-slate-800 px-4 pt-2 pb-6 space-y-2 backdrop-blur-xl"
  >
    <a
      href="/"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Inicio
    </a>
    <a
      href="/#servicios"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Servicios
    </a>
    <a
      href="/#comparativa"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Comparativa Técnica
    </a>
    <a
      href="/#nosotros"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Sobre Nosotros
    </a>
    <a
      href="/#metodologia"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Metodología
    </a>
    <a
      href="/#faq"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Preguntas Frecuentes
    </a>
    <a
      href="/#contacto"
      class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-slate-300 hover:bg-slate-900 hover:text-white"
    >
      Contacto
    </a>

    <div class="pt-3 border-t border-slate-800">
      <a
        href="/#contacto"
        class="w-full inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-5 py-3.5 rounded-xl text-sm transition-all shadow-glow-emerald"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
        </svg>
        <span>Consultar por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-nav-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      const isExpanded = !isHidden;
      btn.setAttribute("aria-expanded", isExpanded ? "true" : "false");
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle("hidden", isExpanded);
        iconClose.classList.toggle("hidden", !isExpanded);
      }
    });

    menu.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        if (iconOpen && iconClose) {
          iconOpen.classList.remove("hidden");
          iconClose.classList.add("hidden");
        }
      });
    });
  }
</script>
