  <!-- ─── SCRIPT DE FORMULARIO DE CONVERSIÓN WHATSAPP Y HONEYPOT ──────── -->
  <script is:inline>
    // @ts-nocheck
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("contact-form");
      const p1 = form?.getAttribute("data-wa-p1") || "504";
      const p2 = form?.getAttribute("data-wa-p2") || "9900";
      const p3 = form?.getAttribute("data-wa-p3") || "0000";
      const WA_PHONE = p1 + p2 + p3;
      const WA_HOST = "https://" + "wa" + ".me/";

      function openWhatsApp(customText) {
        const cleanText = encodeURIComponent(customText || "Hola LaPonTech, quisiera solicitar un diagnóstico gratuito para mi negocio.");
        const targetUrl = WA_HOST + WA_PHONE + "?text=" + cleanText;
        window.open(targetUrl, "_blank", "noopener,noreferrer");
      }

      // Formulario de Contacto Interactivo con Honeypot
      const honeypot = document.getElementById("b_field");
      const formError = document.getElementById("form-error");
      const serviceSelect = document.getElementById("service_select");

      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();

          if (honeypot && honeypot.value.trim() !== "") {
            console.warn("Bot detectado y neutralizado.");
            return;
          }

          const userName = document.getElementById("user_name")?.value.trim() || "";
          const businessName = document.getElementById("business_name")?.value.trim() || "No especificado";
          const serviceVal = serviceSelect?.value || "";
          const serviceText = serviceSelect?.options[serviceSelect.selectedIndex]?.text || serviceVal;
          const message = document.getElementById("user_message")?.value.trim() || "";

          if (!userName || !serviceVal || !message) {
            if (formError) {
              formError.textContent = "Por favor completa tu nombre, el servicio de interés y un breve detalle de lo que necesitas.";
              formError.classList.remove("hidden");
            }
            return;
          }

          if (formError) {
            formError.classList.add("hidden");
          }

          const formattedMessage = 
            `¡Hola LaPonTech! Me comunico desde su portal web:\n\n` +
            `• Nombre: ${userName}\n` +
            `• Negocio/Empresa: ${businessName}\n` +
            `• Servicio de interés: ${serviceText}\n` +
            `• Detalle del requerimiento: ${message}`;

          openWhatsApp(formattedMessage);
        });
      }
    });
  </script>

</Layout>
