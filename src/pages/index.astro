              class="t-press inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-700/80 hover:border-emerald-500/50 text-slate-300 hover:text-emerald-400 text-xs font-medium"
              aria-label="TikTok oficial (Abre en nueva pestaña)"
              title="TikTok"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.77 1.81-.02 3.32-1.52 3.33-3.33.02-4.74.01-9.48.01-14.22-.01-.15.01-.3-.02-.45z"/></svg>
              <span>TikTok</span>
            </a>
          </div>
        </div>

        <!-- Canal 2: Formulario de Contacto con Micro-interacciones de Validación y Confirmación -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-elevation-md">
          <div class="mb-8">
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Envíanos un mensaje</h3>
            <p class="text-sm text-slate-300">Cuéntanos tu proyecto y te responderemos por WhatsApp o correo.</p>
          </div>

          <form id="contact-form" data-wa-p1={waP1} data-wa-p2={waP2} data-wa-p3={waP3} class="space-y-6" novalidate>
            <!-- Honeypot invisible -->
            <div class="hidden" style="display:none !important;" aria-hidden="true">
              <label for="b_field">No llenar este campo:</label>
              <input type="text" id="b_field" name="b_field" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="t-input-wrap">
                <label for="user_name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Tu Nombre <span class="text-emerald-400">*</span>
                </label>
                <input
                  type="text"
                  id="user_name"
                  name="user_name"
                  required
                  placeholder="Ej. Carlos Martínez"
                  class="t-input w-full px-4 py-3 rounded-xl border border-slate-700 bg-slate-950 text-white placeholder-slate-400 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none"
                />
              </div>

              <div>
                <label for="business_name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nombre de tu Negocio o Agencia
                </label>
                <input
                  type="text"
                  id="business_name"
                  name="business_name"
                  placeholder="Ej. Distribuidora Norte / Agencia Creativa"
                  class="t-input w-full px-4 py-3 rounded-xl border border-slate-700 bg-slate-950 text-white placeholder-slate-400 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none"
                />
              </div>
            </div>

            <!-- Selección de Servicio -->
            <div class="t-input-wrap">
              <label for="service_select" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Servicio de Interés <span class="text-emerald-400">*</span>
              </label>
              <select
                id="service_select"
                name="service_select"
                required
                class="t-input w-full px-4 py-3 rounded-xl border border-slate-700 bg-slate-950 text-white text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none cursor-pointer"
              >
                <option value="" disabled selected class="text-slate-400">Selecciona una opción...</option>
                {contacto_whatsapp.select_opciones.map((opt) => (
                  <option value={opt.valor} class="bg-slate-900 text-white">{opt.texto}</option>
                ))}
              </select>
            </div>

            <!-- Mensaje -->
            <div class="t-input-wrap">
              <label for="user_message" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Detalles de lo que necesitas resolver <span class="text-emerald-400">*</span>
              </label>
              <textarea
                id="user_message"
                name="user_message"
                rows="4"
                required
                placeholder="Cuéntanos brevemente qué buscas resolver (ej. crear web para captar clientes, sistema de inventario sin mensualidades, o soporte técnico)..."
                class="t-input w-full px-4 py-3 rounded-xl border border-slate-700 bg-slate-950 text-white placeholder-slate-400 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none"
              ></textarea>
            </div>

            <!-- Alerta de validación -->
            <div
              id="form-error"
              role="alert"
              class="hidden p-4 bg-amber-950/70 border border-amber-500/50 text-amber-200 rounded-xl text-sm font-medium"
            ></div>

            <!-- Botón de Envío con Icon Swap + Text Swap -->
            <button
              type="submit"
              id="submit-form-btn"
              class="t-press w-full inline-flex items-center justify-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold py-4 px-8 rounded-xl shadow-elevation-md hover:shadow-elevation-lg hover:-translate-y-0.5 min-h-[52px] text-base cursor-pointer"
            >
              <span id="submit-btn-icon" class="t-icon-swap" data-state="a" aria-hidden="true">
                <svg class="t-icon w-5 h-5 fill-current" data-icon="a" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
                </svg>
                <svg class="t-icon w-5 h-5" data-icon="b" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <span id="submit-btn-text" class="t-text-swap">Consultar requerimiento por WhatsApp</span>
            </button>

            <p class="text-xs text-slate-400 text-center">
              Tus datos se transmiten directamente a través de WhatsApp. Sin spam ni almacenamiento invasivo.
            </p>
          </form>
        </div>

      </div>

    </div>
  </section>

  <!-- ─── 9. BOTÓN FLOTANTE DISCRETO DE WHATSAPP (CSS PURO) ─────────────── -->
  <aside aria-label="Contacto Rápido">
    <a
      href="#contacto"
      data-wa-text={WA_DIRECT_MSG}
      aria-label="Contactar a LaPonTech por WhatsApp (Respuesta en horario hábil)"
      class="js-protected-wa t-press fixed bottom-6 right-6 z-50 group inline-flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-4 py-3 rounded-full shadow-elevation-lg hover:-translate-y-0.5"
    >
      <div class="relative flex items-center justify-center">
        <svg class="w-6 h-6 fill-current transition-transform duration-200 group-hover:scale-105" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
        </svg>
      </div>
      <span class="hidden sm:inline text-xs font-extrabold tracking-tight">WhatsApp Directo</span>
      <span class="hidden md:inline-block w-1 h-1 rounded-full bg-slate-950/40"></span>
      <span class="hidden md:inline text-xs font-bold text-slate-900">Horario hábil</span>
    </a>
  </aside>

  <!-- ─── SCRIPT DE ACORDEÓN FAQ + FORMULARIO WHATSAPP CON MICRO-INTERACCIONES ── -->
  <script is:inline>
    // @ts-nocheck
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Acordeón fluido de Preguntas Frecuentes (21-accordion)
      const accordions = document.querySelectorAll("#faq-accordion-list .t-acc");
      accordions.forEach((acc) => {
        const head = acc.querySelector(".t-acc-head");
        if (!head) return;
        head.addEventListener("click", () => {
          const isOpen = acc.getAttribute("data-open") === "true";
          const nextState = String(!isOpen);
          acc.setAttribute("data-open", nextState);
          head.setAttribute("aria-expanded", nextState);
        });
      });

      // 2. Formulario de Contacto Interactivo con Honeypot, Error Shake (12) y Text/Icon Swap (04, 09)
      const form = document.getElementById("contact-form");
      const p1 = form?.getAttribute("data-wa-p1") || "504";
      const p2 = form?.getAttribute("data-wa-p2") || "8900";
      const p3 = form?.getAttribute("data-wa-p3") || "5569";
      const WA_PHONE = p1 + p2 + p3;
      const WA_HOST = "https://" + "wa" + ".me/";
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function openWhatsApp(customText) {
        const cleanText = encodeURIComponent(customText || "Hola LaPonTech, quisiera solicitar un diagnóstico gratuito para mi negocio.");
        const targetUrl = WA_HOST + WA_PHONE + "?text=" + cleanText;
        window.open(targetUrl, "_blank", "noopener,noreferrer");
      }

      const honeypot = document.getElementById("b_field");
      const formError = document.getElementById("form-error");
      const userNameEl = document.getElementById("user_name");
      const businessNameEl = document.getElementById("business_name");
      const serviceSelect = document.getElementById("service_select");
      const userMessageEl = document.getElementById("user_message");
      const submitBtnIcon = document.getElementById("submit-btn-icon");
      const submitBtnText = document.getElementById("submit-btn-text");

      const cs = getComputedStyle(document.documentElement);
      const getMs = (name, fb) => {
        const v = parseFloat(cs.getPropertyValue(name));
        return Number.isFinite(v) ? v : fb;
      };

      function triggerFieldError(fieldEl) {
        if (!fieldEl) return;
        const wrap = fieldEl.closest(".t-input-wrap");
        if (wrap) wrap.classList.add("is-error");
        fieldEl.classList.add("is-error");
        fieldEl.setAttribute("aria-invalid", "true");

        if (!prefersReduced) {
          fieldEl.classList.remove("is-shaking");
          void fieldEl.offsetWidth; // Reflow para re-disparar la animación
          fieldEl.classList.add("is-shaking");

          const shakeMs = getMs("--shake-dur-a", 80) * 2 + getMs("--shake-dur-b", 60) * 2;
          setTimeout(() => fieldEl.classList.remove("is-shaking"), shakeMs + 20);
        }

        if (fieldEl._revertTimer) clearTimeout(fieldEl._revertTimer);
        const holdMs = getMs("--revert-hold", 3500);
        fieldEl._revertTimer = setTimeout(() => {
          fieldEl._revertTimer = null;
          if (wrap) wrap.classList.remove("is-error");
          fieldEl.classList.remove("is-error");
        }, holdMs);
      }

      function clearFieldError(fieldEl) {
        if (!fieldEl) return;
        if (fieldEl._revertTimer) {
          clearTimeout(fieldEl._revertTimer);
          fieldEl._revertTimer = null;
        }
        const wrap = fieldEl.closest(".t-input-wrap");
        if (wrap) wrap.classList.remove("is-error");
        fieldEl.classList.remove("is-error", "is-shaking");
        fieldEl.removeAttribute("aria-invalid");

        if (
          formError &&
          !formError.classList.contains("hidden") &&
          userNameEl?.value.trim() &&
          serviceSelect?.value &&
          userMessageEl?.value.trim()
        ) {
          formError.classList.add("hidden");
        }
      }

      [userNameEl, serviceSelect, userMessageEl].forEach((el) => {
        if (!el) return;
        el.addEventListener("input", () => clearFieldError(el));
        el.addEventListener("change", () => clearFieldError(el));
      });

      function swapButtonLabel(nextLabel) {
        if (!submitBtnText) return;
        if (prefersReduced) {
          submitBtnText.textContent = nextLabel;
          return;
        }
        const dur = getMs("--text-swap-dur", 150);
        submitBtnText.classList.add("is-exit");
        setTimeout(() => {
          submitBtnText.textContent = nextLabel;
          submitBtnText.classList.remove("is-exit");
          submitBtnText.classList.add("is-enter-start");
          void submitBtnText.offsetHeight;
          submitBtnText.classList.remove("is-enter-start");
        }, dur);
      }

      if (form) {
        let confirmTimer = null;
        const defaultBtnLabel = "Consultar requerimiento por WhatsApp";

        form.addEventListener("submit", (e) => {
          e.preventDefault();

          if (honeypot && honeypot.value.trim() !== "") {
            console.warn("Bot detectado y neutralizado.");
            return;
          }

          const userName = userNameEl?.value.trim() || "";
          const businessName = businessNameEl?.value.trim() || "No especificado";
          const serviceVal = serviceSelect?.value || "";
          const serviceText = serviceSelect?.options[serviceSelect.selectedIndex]?.text || serviceVal;
          const message = userMessageEl?.value.trim() || "";

          const missingFields = [];
          if (!userName) missingFields.push(userNameEl);
          if (!serviceVal) missingFields.push(serviceSelect);
          if (!message) missingFields.push(userMessageEl);

          if (missingFields.length > 0) {
            missingFields.forEach((field) => triggerFieldError(field));
            missingFields[0]?.focus();
            if (formError) {
              formError.textContent = "Por favor completa los campos resaltados (nombre, servicio de interés y un breve detalle).";
              formError.classList.remove("hidden");
            }
            return;
          }

          if (formError) {
            formError.classList.add("hidden");
          }

          // Confirmación táctil en el botón mientras se abre WhatsApp
          if (confirmTimer) clearTimeout(confirmTimer);
          if (submitBtnIcon) submitBtnIcon.setAttribute("data-state", "b");
          swapButtonLabel("¡Abriendo WhatsApp con tu consulta!");

          confirmTimer = setTimeout(() => {
            if (submitBtnIcon) submitBtnIcon.setAttribute("data-state", "a");
            swapButtonLabel(defaultBtnLabel);
          }, 2800);

          const formattedMessage = 
            `¡Hola LaPonTech! Me comunico desde su portal web:\n\n` +
            `• Nombre: ${userName}\n` +
            `• Negocio/Empresa: ${businessName}\n` +
            `• Servicio de interés: ${serviceText}\n` +
            `• Detalle del requerimiento: ${message}`;

          openWhatsApp(formattedMessage);
        });
      }
    });
  </script>

</Layout>
