---
// Archivo: src/pages/index.astro
// Arquitectura: Astro + Tailwind CSS (Rendimiento 95-100 PageSpeed, CRO Mobile-First)
import Layout from "../layouts/Layout.astro";
import serviciosData from "../json/servicios.json";

const { empresa, hero, por_que_nosotros, servicios, agencias, sobre_nosotros, metodologia, garantias, faq, contacto_whatsapp } = serviciosData;

const pageTitle = "LaPonTech | Páginas Web, Sistemas a Medida y Marca Blanca";
const pageDescription = "Páginas web rápidas, sistemas a medida sin rentas forzosas y brazo técnico en marca blanca para agencias en San Pedro Sula y Honduras. ¡Cotiza por WhatsApp!";

const WA_DIRECT_MSG = "Hola LaPonTech, quisiera solicitar información sobre sus servicios.";
const WA_AGENCIAS_MSG = agencias.wa_msg;
const phoneClean = empresa.telefono_clean;
const waP1 = phoneClean.slice(0, 3);
const waP2 = phoneClean.slice(3, 7);
const waP3 = phoneClean.slice(7);
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- ─── 1. HERO SECTION (CRO DUAL CTA + STATIC COUNTERS) ────────────────── -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-28 border-b border-slate-800/80">
    <!-- Ambient Light & Tech Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-emerald-500/10 blur-[130px] rounded-full pointer-events-none" aria-hidden="true"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2.5 bg-slate-900/90 border border-slate-700 text-emerald-300 text-xs sm:text-sm font-semibold px-4 py-2 rounded-full mb-8 backdrop-blur-md shadow-elevation-sm">
          <span class="t-status-dot w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>San Pedro Sula, Cortés · {hero.badge}</span>
        </div>

        <!-- Título Principal de Alto Impacto -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15] mb-6">
          {hero.titulo_principal}{" "}
          <span class="text-emerald-400">
            {hero.titulo_destacado}
          </span>
        </h1>

        <!-- Subtítulo CRO (Ventaja Técnica Real vs WordPress) -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-[56ch] mx-auto mb-10 leading-relaxed font-normal">
          {hero.subtitulo}
        </p>

        <!-- CTA Dual Estratégico (WhatsApp Principal + Comparativa Secundaria) -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <div class="w-full sm:w-auto flex flex-col items-center">
            <a
              href="#contacto"
              data-wa-text={WA_DIRECT_MSG}
              aria-label="Solicitar Diagnóstico Gratuito por WhatsApp (Abre en nueva pestaña)"
              class="js-protected-wa t-press w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-8 py-4 rounded-xl shadow-elevation-md hover:shadow-elevation-lg hover:-translate-y-0.5 min-h-[52px] text-base cursor-pointer"
            >
              <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
              </svg>
              <span>{hero.cta_whatsapp_texto}</span>
            </a>
            <span class="text-xs text-slate-400 mt-2 font-medium flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              {hero.cta_microtexto}
            </span>
          </div>

          <a
            href="#comparativa"
            class="t-press group/cta w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-bold px-7 py-4 rounded-xl border border-slate-700/80 hover:border-emerald-500/50 hover:-translate-y-0.5 min-h-[52px] text-base backdrop-blur-sm"
          >
            <span>{hero.cta_comparativa_texto}</span>
            <svg class="w-4 h-4 text-emerald-400 transition-transform duration-200 group-hover/cta:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>

        <!-- 4 Métricas Estáticas de Alto Contraste con Elevación y Hover Físico -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-10 border-t border-slate-800/80">
          {hero.estadisticas.map((stat) => (
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 hover:-translate-y-1 hover:shadow-card-subtle transition-[transform,border-color,box-shadow] duration-200 text-center group flex flex-col justify-center">
              <p class="text-2xl sm:text-3xl font-black text-amber-300 font-mono mb-1.5 group-hover:text-emerald-400 transition-colors duration-200">
                {stat.valor}
              </p>
              <p class="text-sm sm:text-base font-bold text-white mb-1 leading-snug">{stat.etiqueta}</p>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{stat.detalle}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ─── 2. BENTO GRID: SERVICIOS Y SOLUCIONES TECNOLÓGICAS ────────────── -->
  <section id="servicios" class="py-20 lg:py-28 border-b border-slate-800/80 scroll-mt-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Servicios y Soluciones para tu Negocio
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-[58ch] mx-auto">
          Diseñamos páginas web para captar clientes, sistemas a medida para ordenar tu operación, automatizaciones por WhatsApp y asesoría en equipos. Rápidos, fáciles de usar y 100% de tu propiedad.
        </p>
      </div>

      <!-- Bento Grid de Servicios -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-6xl mx-auto">
        
        {servicios.map((servicio, idx) => {
          const isWide = idx === 0;
          const colSpan = isWide ? "lg:col-span-7" : idx === 1 ? "lg:col-span-5" : "lg:col-span-6";
          const cleanCta = (servicio.cta_texto || "Cotizar este servicio").replace(/\s*→$/, "");

          return (
            <article
              id={servicio.id}
              class={`${colSpan} reveal-on-scroll rounded-3xl p-6 sm:p-8 bg-slate-900 border transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-card-subtle flex flex-col justify-between relative overflow-hidden group ${
                servicio.popular
                  ? "border-emerald-500/50 ring-1 ring-emerald-500/20 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950"
                  : "border-slate-800 hover:border-slate-700 bg-slate-900/90"
              }`}
            >
              {servicio.popular && (
                <div class="absolute top-0 right-0 bg-emerald-500 text-slate-950 text-xs font-black px-3.5 py-1 rounded-bl-xl uppercase tracking-wider">
                  Alta Demanda
                </div>
              )}

              <div>
                <!-- Encabezado con Icono y Badges -->
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  {servicio.badges.map((badge) => (
                    <span class="inline-flex items-center text-xs font-mono font-semibold px-2.5 py-0.5 rounded-md bg-slate-800 text-emerald-300 border border-slate-700 transition-colors duration-200 group-hover:border-emerald-500/40">
                      {badge}
                    </span>
                  ))}
                </div>

                <div class="flex items-start gap-3 mb-2">
                  <span class="mt-1 text-emerald-400 flex-shrink-0 group-hover:scale-110 transition-transform duration-200" aria-hidden="true">
                    {servicio.id === "presencia-digital" && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                    )}
                    {servicio.id === "facturacion-inventario" && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    )}
                    {servicio.id === "automatizaciones" && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    )}
                    {servicio.id === "asesoria-tecnica" && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    )}
                  </span>
                  <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">{servicio.titulo}</h3>
                </div>
                <p class="text-emerald-400 font-semibold text-xs sm:text-sm mb-3 max-w-[50ch]">{servicio.subtitulo}</p>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 max-w-[50ch]">
                  {servicio.descripcion}
                </p>

                <!-- Micro-Lista con Viñetas Concisas -->
                <ul class="space-y-2.5 mb-8 max-w-[50ch]" aria-label={`Características técnicas de ${servicio.titulo}`}>
                  {servicio.puntos_clave.map((punto) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                      <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{punto}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Micro-Acción Directa por WhatsApp con Chevron Spread (24-learn-more-hover) -->
              <div class="pt-5 border-t border-slate-800 mt-auto flex flex-col sm:flex-row gap-3">
                <a
                  href="#contacto"
                  data-wa-text={servicio.wa_msg}
                  aria-label={`Cotizar ${servicio.titulo} por WhatsApp (Abre en nueva pestaña)`}
                  class="js-protected-wa t-learn t-press w-full inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-white font-bold py-3.5 px-6 rounded-xl border border-slate-700 hover:border-emerald-500 text-sm cursor-pointer group-hover:bg-emerald-500 group-hover:text-slate-950 group-hover:border-emerald-500"
                >
                  <span>{cleanCta}</span>
                  <span class="t-learn-chevron" aria-hidden="true">
                    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" stroke-width="2" stroke-linecap="round" />
                      <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </span>
                </a>
              </div>
            </article>
          );
        })}

      </div>
    </div>
  </section>

  <!-- ─── 3. TABLA COMPARATIVA TÉCNICA (LAPONTECH VS OTRAS AGENCIAS / WP) ── -->
  <section id="comparativa" class="py-20 lg:py-28 bg-slate-900/40 border-b border-slate-800/80 scroll-mt-20 relative">
    <div id="por-que-nosotros" class="absolute -top-20" aria-hidden="true"></div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      
      <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          {por_que_nosotros.titulo}
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-[58ch] mx-auto">
          {por_que_nosotros.subtitulo}
        </p>
      </div>

      <!-- Matriz de Comparativa Compacta y Mobile-First -->
      <div class="space-y-4">
        {por_que_nosotros.comparativa.map((item) => (
          <div class="reveal-on-scroll bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 transition-[border-color,box-shadow] duration-200 hover:border-slate-700 hover:shadow-card-subtle">
            
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                <span>{item.criterio}</span>
              </h3>
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-800/50">
                {item.badge}
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 pt-4 border-t border-slate-800/80">
              <!-- Nuestro Enfoque en LaPonTech -->
              <div class="space-y-1.5">
                <p class="text-xs font-bold text-emerald-400 uppercase tracking-wide flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span>Nuestro Enfoque en LaPonTech</span>
                </p>
                <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-medium">
                  {item.nosotros}
                </p>
              </div>

              <!-- El Problema Frecuente -->
              <div class="space-y-1.5">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wide flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                  <span>El Problema Frecuente</span>
                </p>
                <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                  {item.otros}
                </p>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── 3.5. SECCIÓN PARA AGENCIAS (SERVICIO TÉCNICO EN MARCA BLANCA) ──── -->
  <section id="agencias" class="py-20 lg:py-28 border-b border-slate-800/80 scroll-mt-20 relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900/60 to-slate-950">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
      
      <div class="text-center max-w-3xl mx-auto mb-14 reveal-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          {agencias.titulo}
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-5 max-w-[58ch] mx-auto">
          {agencias.subtitulo}
        </p>
        <p class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-emerald-300 bg-emerald-950/50 border border-emerald-700/40 px-4 py-2 rounded-xl">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span>{agencias.compromiso_respeto}</span>
        </p>
      </div>

      <!-- 3 Áreas de Ejecución Técnica en Marca Blanca -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {agencias.areas.map((area) => (
          <div class="reveal-on-scroll bg-slate-900 border border-slate-800 hover:border-emerald-500/40 hover:-translate-y-1 rounded-2xl p-6 flex flex-col justify-between transition-[transform,border-color,box-shadow] duration-300 shadow-card-subtle">
            <div>
              <span class="inline-block text-xs font-mono font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-800/40 px-2.5 py-1 rounded-md mb-4">
                {area.badge}
              </span>
              <h3 class="text-lg font-bold text-white mb-2.5 leading-snug">{area.titulo}</h3>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">{area.descripcion}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Banner de Condición Especial para Primeros Encargos -->
      <div class="reveal-on-scroll bg-gradient-to-r from-slate-900 via-emerald-950/30 to-slate-900 border border-emerald-500/30 rounded-3xl p-6 sm:p-8 flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl text-center lg:text-left">
          <span class="inline-block text-xs font-mono font-bold text-amber-300 bg-amber-950/60 border border-amber-500/30 px-3 py-1 rounded-full mb-3">
            {agencias.condicion_especial.badge}
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white mb-2">
            {agencias.condicion_especial.titulo}
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-[58ch] mx-auto lg:mx-0">
            {agencias.condicion_especial.descripcion}
          </p>
        </div>

        <div class="flex flex-col items-center lg:items-end flex-shrink-0 w-full lg:w-auto">
          <a
            href="#contacto"
            data-wa-text={WA_AGENCIAS_MSG}
            aria-label="Solicitar Tarifas de Marca Blanca por WhatsApp (Abre en nueva pestaña)"
            class="js-protected-wa t-press w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-6 py-4 rounded-xl shadow-elevation-md hover:shadow-elevation-lg hover:-translate-y-0.5 text-sm cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.534 1.768.814 2.801.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.773-5.768zm3.364 8.163c-.14.393-.812.728-1.127.776-.309.047-.712.063-1.144-.078-.276-.089-.63-.223-1.077-.417-1.905-.826-3.14-2.766-3.235-2.893-.095-.127-.775-1.03-.775-1.964s.489-1.394.663-1.585c.174-.191.38-.239.507-.239.127 0 .253.001.364.007.118.006.276-.045.432.329.16.386.547 1.332.595 1.43.048.098.079.213.016.341-.063.127-.095.206-.19.317-.095.111-.2.248-.286.333-.095.095-.195.198-.084.389.111.19.494.814 1.059 1.318.729.649 1.344.85 1.534.945.19.095.301.079.412-.048.111-.127.476-.555.603-.745.127-.19.254-.159.428-.095.174.063 1.11.523 1.3.618.19.095.317.143.364.222.048.079.048.46-.095.853z"/>
            </svg>
            <span>{agencias.cta_texto}</span>
          </a>
          <span class="text-xs text-slate-400 mt-2 text-center lg:text-right">
            {agencias.cta_microtexto}
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── 4. SOBERANÍA DIGITAL & FUNDADORES TÉCNICOS (BENTO COMPACTO) ─────── -->
