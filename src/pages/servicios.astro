// Archivo: src/pages/servicios.astro
// Redirección limpia e inmediata a la sección unificada de servicios en la landing page principal
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="0;url=/#servicios" />
    <link rel="canonical" href="https://lapontech.com/" />
    <meta name="robots" content="noindex, follow" />
    <title>Servicios | LaPon Tech Solutions</title>
    <script is:inline>
      window.location.replace('/#servicios');
    </script>
  </head>
  <body class="bg-slate-950 text-slate-300 flex items-center justify-center min-h-screen p-4 text-center font-sans">
    <div class="max-w-md p-6 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl">
      <p class="text-sm text-slate-300 mb-4">
        Redirigiendo a la sección de servicios en LaPon Tech Solutions...
      </p>
      <a
        href="/#servicios"
        class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-5 py-2.5 rounded-xl text-sm transition-all"
      >
        Ir a Servicios →
      </a>
    </div>
  </body>
</html>
